{
  "name": "ikasbide",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ngc --noEmit -p tsconfig.app.json && tsc -p tsconfig.e2e.json",
    "build:e2e": "npm run build && node scripts/prepare-e2e.mjs",
    "emulators": "firebase emulators:start --project demo-ikasbide --only auth,hosting",
    "test": "npm run test:e2e",
    "test:e2e": "npm run build:e2e && firebase emulators:exec --project demo-ikasbide --only auth,hosting \"playwright test\"",
    "format:check": "prettier --check .",
    "deploy": "npm run build && node scripts/check-deploy.mjs && firebase deploy --project default --only hosting"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "firebase-tools": "^15.34.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
