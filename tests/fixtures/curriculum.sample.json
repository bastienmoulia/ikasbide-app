{
  "schemaVersion": 1,
  "units": [
    {
      "id": "unit-1",
      "number": 1,
      "title": { "eu": "Lehen urratsak", "fr": "Premiers pas" },
      "chapters": [
        {
          "id": "chapter-1",
          "number": 1,
          "title": { "eu": "Aurkezpenak", "fr": "Les présentations" },
          "objectives": [
            {
              "id": "greet-and-introduce",
              "label": { "eu": "Agurtu eta zure burua aurkeztu", "fr": "Saluer et se présenter" }
            },
            {
              "id": "say-origin-and-residence",
              "label": {
                "eu": "Nongoa zaren eta non bizi zaren esan",
                "fr": "Dire d’où l’on vient et où l’on habite"
              }
            }
          ],
          "sequences": [
            {
              "id": "greetings",
              "letter": "A",
              "title": { "eu": "Kaixo!", "fr": "Bonjour !" },
              "contents": [
                {
                  "type": "resource",
                  "kind": "note",
                  "id": "greetings-note",
                  "title": { "eu": "Agurrak", "fr": "Les salutations" },
                  "body": {
                    "eu": "Kaixo edozein unetan erabil daiteke. Goizean egun on esaten da, eta gauean gabon.",
                    "fr": "« Kaixo » s’utilise à tout moment. Le matin, on dit « egun on » et le soir « gabon »."
                  }
                },
                {
                  "type": "resource",
                  "kind": "dialogue",
                  "id": "greetings-dialogue",
                  "title": { "eu": "Elkarrizketa eredua", "fr": "Modèle de dialogue" },
                  "lines": [
                    {
                      "speaker": "Miren",
                      "text": {
                        "eu": "Kaixo! Miren naiz. Eta zu?",
                        "fr": "Bonjour ! Je suis Miren. Et toi ?"
                      }
                    },
                    {
                      "speaker": "Jon",
                      "text": { "eu": "Kaixo, Jon naiz.", "fr": "Bonjour, je suis Jon." }
                    }
                  ]
                },
                {
                  "type": "activity",
                  "kind": "gap-fill",
                  "id": "greetings-gaps",
                  "title": { "eu": "Osatu esaldiak", "fr": "Complétez les phrases" },
                  "instructions": {
                    "eu": "Idatzi falta den hitza edo atzizkia.",
                    "fr": "Écrivez le mot ou le suffixe manquant."
                  },
                  "items": [
                    {
                      "id": "greetings-gap-1",
                      "objectiveIds": ["greet-and-introduce"],
                      "prompt": { "eu": "Kaixo, Jon ___.", "fr": "Bonjour, je suis Jon." },
                      "acceptedAnswers": ["naiz"]
                    },
                    {
                      "id": "greetings-gap-2",
                      "objectiveIds": ["say-origin-and-residence"],
                      "prompt": { "eu": "Ni Baiona___ naiz.", "fr": "Je suis de Bayonne." },
                      "acceptedAnswers": ["koa"]
                    },
                    {
                      "id": "greetings-gap-3",
                      "objectiveIds": ["greet-and-introduce"],
                      "prompt": { "eu": "Egun ___!", "fr": "Bonjour ! (le matin)" },
                      "acceptedAnswers": ["on"]
                    },
                    {
                      "id": "greetings-gap-4",
                      "objectiveIds": ["greet-and-introduce"],
                      "prompt": { "eu": "___, Miren!", "fr": "Bonjour, Miren !" },
                      "acceptedAnswers": ["Kaixo"],
                      "warningAnswers": ["Egun on"]
                    }
                  ]
                },
                {
                  "type": "activity",
                  "kind": "multiple-choice",
                  "id": "greetings-choices",
                  "title": { "eu": "Aukeratu agurra", "fr": "Choisissez la salutation" },
                  "instructions": {
                    "eu": "Aukeratu erantzun egokia.",
                    "fr": "Choisissez la bonne réponse."
                  },
                  "items": [
                    {
                      "id": "greetings-choice-1",
                      "objectiveIds": ["greet-and-introduce"],
                      "prompt": {
                        "eu": "Nola esaten da « au revoir » euskaraz?",
                        "fr": "Comment dit-on « au revoir » en basque ?"
                      },
                      "choices": [
                        { "id": "agur", "lang": "eu", "text": "Agur" },
                        { "id": "kaixo", "lang": "eu", "text": "Kaixo" },
                        { "id": "eskerrik-asko", "lang": "eu", "text": "Eskerrik asko" }
                      ],
                      "correctChoiceIds": ["agur"]
                    },
                    {
                      "id": "greetings-choice-2",
                      "objectiveIds": ["greet-and-introduce"],
                      "prompt": {
                        "eu": "Zein agur erabiltzen da goizean?",
                        "fr": "Quelle salutation utilise-t-on le matin ?"
                      },
                      "choices": [
                        { "id": "egun-on", "lang": "eu", "text": "Egun on" },
                        { "id": "gabon", "lang": "eu", "text": "Gabon" }
                      ],
                      "correctChoiceIds": ["egun-on"]
                    }
                  ]
                }
              ]
            },
            {
              "id": "origin",
              "letter": "B",
              "title": { "eu": "Nongoa zara?", "fr": "D’où es-tu ?" },
              "contents": [
                {
                  "type": "resource",
                  "kind": "note",
                  "id": "origin-note",
                  "title": { "eu": "-ko atzizkia", "fr": "Le suffixe -ko" },
                  "body": {
                    "eu": "Jatorria adierazteko, herriaren izenari -ko gehitzen zaio: Baiona → Baionakoa.",
                    "fr": "Pour indiquer l’origine, on ajoute -ko au nom de la ville : Baiona → Baionakoa."
                  }
                },
                {
                  "type": "resource",
                  "kind": "external-link",
                  "id": "origin-audio",
                  "title": { "eu": "Entzungaiak", "fr": "Enregistrements audio" },
                  "description": {
                    "eu": "Adibideko kanpo orrialde batean entzun daitezke.",
                    "fr": "À écouter sur une page externe d’exemple."
                  },
                  "url": "https://example.org/ikasbide-audio"
                },
                {
                  "type": "activity",
                  "kind": "translation",
                  "id": "origin-translation",
                  "title": { "eu": "Itzuli", "fr": "Traduisez" },
                  "instructions": {
                    "eu": "Itzuli esaldiak beste hizkuntzara.",
                    "fr": "Traduisez les phrases dans l’autre langue."
                  },
                  "items": [
                    {
                      "id": "origin-translation-1",
                      "objectiveIds": ["say-origin-and-residence"],
                      "direction": "fr-eu",
                      "source": "Je suis de Bayonne.",
                      "acceptedAnswers": ["Baionakoa naiz.", "Ni Baionakoa naiz."]
                    },
                    {
                      "id": "origin-translation-2",
                      "objectiveIds": ["say-origin-and-residence"],
                      "direction": "eu-fr",
                      "source": "Bilbon bizi naiz.",
                      "acceptedAnswers": ["J’habite à Bilbao.", "Je vis à Bilbao."],
                      "warningAnswers": ["Je réside à Bilbao."]
                    }
                  ]
                },
                {
                  "type": "activity",
                  "kind": "word-order",
                  "id": "origin-word-order",
                  "title": { "eu": "Ordenatu hitzak", "fr": "Remettez les mots dans l’ordre" },
                  "instructions": {
                    "eu": "Osatu esaldia hitz guztiak erabiliz.",
                    "fr": "Formez la phrase en utilisant tous les mots."
                  },
                  "items": [
                    {
                      "id": "origin-word-order-1",
                      "objectiveIds": ["say-origin-and-residence"],
                      "prompt": {
                        "eu": "Galdetu nongoa den.",
                        "fr": "Demandez d’où vient la personne."
                      },
                      "words": ["zara", "Zu", "nongoa"],
                      "acceptedAnswers": ["Zu nongoa zara?", "Nongoa zara zu?"]
                    },
                    {
                      "id": "origin-word-order-2",
                      "objectiveIds": ["say-origin-and-residence"],
                      "prompt": {
                        "eu": "Esan Bilbon bizi zarela.",
                        "fr": "Dites que vous habitez à Bilbao."
                      },
                      "words": ["bizi", "Bilbon", "naiz"],
                      "acceptedAnswers": ["Bilbon bizi naiz."],
                      "warningAnswers": ["Bizi naiz Bilbon."]
                    }
                  ]
                },
                {
                  "type": "activity",
                  "kind": "oral-prompt",
                  "id": "origin-pair-talk",
                  "title": { "eu": "Elkarrizketa bikoteka", "fr": "Dialogue à deux" },
                  "instructions": {
                    "eu": "Aurkeztu zure burua lagun bati eta galdetu nongoa den.",
                    "fr": "Présentez-vous à un·e partenaire et demandez-lui d’où il ou elle vient."
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "chapter-2",
          "number": 2,
          "title": { "eu": "Familia", "fr": "La famille" },
          "objectives": [
            {
              "id": "name-family-members",
              "label": { "eu": "Familiakoak izendatu", "fr": "Nommer les membres de sa famille" }
            }
          ],
          "sequences": [
            {
              "id": "family-words",
              "letter": "A",
              "title": { "eu": "Nire familia", "fr": "Ma famille" },
              "contents": [
                {
                  "type": "activity",
                  "kind": "multiple-choice",
                  "id": "family-choices",
                  "title": { "eu": "Familiako hitzak", "fr": "Les mots de la famille" },
                  "instructions": { "eu": "Aukeratu hitz egokia.", "fr": "Choisissez le bon mot." },
                  "items": [
                    {
                      "id": "family-choice-1",
                      "objectiveIds": ["name-family-members"],
                      "prompt": { "eu": "« mère » euskaraz", "fr": "« mère » en basque" },
                      "choices": [
                        { "id": "ama", "lang": "eu", "text": "ama" },
                        { "id": "aita", "lang": "eu", "text": "aita" }
                      ],
                      "correctChoiceIds": ["ama"]
                    },
                    {
                      "id": "family-choice-2",
                      "objectiveIds": ["name-family-members"],
                      "prompt": { "eu": "« père » euskaraz", "fr": "« père » en basque" },
                      "choices": [
                        { "id": "ama", "lang": "eu", "text": "ama" },
                        { "id": "aita", "lang": "eu", "text": "aita" }
                      ],
                      "correctChoiceIds": ["aita"]
                    },
                    {
                      "id": "family-choice-3",
                      "objectiveIds": ["name-family-members"],
                      "prompt": {
                        "eu": "« frère » euskaraz",
                        "fr": "« frère » en basque"
                      },
                      "choices": [
                        { "id": "anaia", "lang": "eu", "text": "anaia" },
                        { "id": "aita", "lang": "eu", "text": "aita" }
                      ],
                      "correctChoiceIds": ["anaia"]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
