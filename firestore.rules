rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Published curriculum: readable by any Google account (ADR 0001), written only by the
    // trusted maintainer import, which uses the Admin SDK and bypasses these rules.
    function isGoogleLearner() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /units/{unitId} {
      allow read: if isGoogleLearner();
    }

    match /chapters/{chapterId} {
      allow read: if isGoogleLearner();
    }
  }
}
